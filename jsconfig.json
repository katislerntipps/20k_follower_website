{
  "compilerOptions": {
    "checkJs": true,
    "module": "ESNext",
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./js/*"],
      "@modules/*": ["./js/modules/*"]
    }
  },
  "include": ["js/**/*"],
  "exclude": ["node_modules", "js/**/*.min.js", "js/vendor/*"]
}
